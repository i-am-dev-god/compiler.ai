{
  "name": "tracegym",
  "version": "0.1.0",
  "description": "A browser-based Python workbench and debugging tutor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "verify:curriculum": "node scripts/verify-curriculum.mjs",
    "verify": "npm run test && npm run verify:curriculum && npm run build",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "postinstall": "node scripts/vendor-pyodide.mjs",
    "prebuild": "node scripts/vendor-pyodide.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-am-dev-god/compiler.ai.git"
  },
